# Frontend nginx. Rendered at container start: the nginx image replaces the
# ${FRONTEND_PROXY_*} names below with the values from .env. DO NOT EDIT - set
# the FRONTEND_PROXY_* keys in .env instead (README step 5).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's DNS, re-resolved so a restarted backend is picked up.
  resolver 127.0.0.11 valid=10s;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;
  client_max_body_size 20m;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # WebSocket and server-sent events (live price streams)
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600s;

  # Route 1 - prefix removed:  /<prefix>/x  ->  Node API  /x
  location ~ ^/(${FRONTEND_PROXY_NODE_PREFIX})/ {
    set $node_upstream ${FRONTEND_PROXY_NODE_TARGET};
    rewrite ^/(${FRONTEND_PROXY_NODE_PREFIX})/(.*)$ /$2 break;
    proxy_pass $node_upstream;
    # A cookie the backend scopes to /foo must reach the browser as /<prefix>/foo.
    proxy_cookie_path ~^/(.+)$ /${FRONTEND_PROXY_NODE_PREFIX}/$1;
  }

  # Route 2 - prefix removed:  /<prefix>/x  ->  Java API  /x
  location ~ ^/(${FRONTEND_PROXY_JAVA_PREFIX})/ {
    set $java_upstream ${FRONTEND_PROXY_JAVA_TARGET};
    rewrite ^/(${FRONTEND_PROXY_JAVA_PREFIX})/(.*)$ /$2 break;
    proxy_pass $java_upstream;
    proxy_cookie_path ~^/(.+)$ /${FRONTEND_PROXY_JAVA_PREFIX}/$1;
  }

  # Route 3 - path passed through unchanged:  /api/x  ->  <target>/api/x
  location ~ ^/(${FRONTEND_PROXY_KEEP_PATHS})(/|$) {
    set $keep_upstream ${FRONTEND_PROXY_KEEP_TARGET};
    proxy_pass $keep_upstream;
  }

  # Route 4 - a second pass-through target (e.g. auth paths going to the Node API)
  location ~ ^/(${FRONTEND_PROXY_KEEP2_PATHS})(/|$) {
    set $keep2_upstream ${FRONTEND_PROXY_KEEP2_TARGET};
    proxy_pass $keep2_upstream;
  }

  # Single-page app: unknown paths get index.html and the app routes them.
  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:js|mjs|css|html|json|webmanifest)$ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location ~* \.(?:png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$ {
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }
}
