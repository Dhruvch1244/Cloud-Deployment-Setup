# ==============================================================================
# .env  -  THE ONE FILE YOU EDIT.   cp docker-template/.env.example .env
#
#   Section 1  MUST change      (values marked CHANGE_ME; check.sh refuses them)
#   Section 2  CHECK per app    (folders, ports, health paths, frontend addresses)
#   Section 3  APP-SPECIFIC     (variable names only YOUR code reads)
#   Section 4  Rarely changed
#
# Comments go on their OWN line: `KEY=value  # note` can end up inside the value.
# Never commit .env. Values are passed into every app container (env_file), so
# anything written for "running on my laptop" (localhost:...) is wrong here:
# inside Compose, services reach each other by SERVICE NAME (postgres, kafka,
# node-api, java-api, java-worker, mailpit).
# ==============================================================================


# ============================ 1. MUST CHANGE ==================================
# short lowercase name, e.g. etp
COMPOSE_PROJECT_NAME=CHANGE_ME

# What to run. Delete the names you do not have; nothing else has to be removed.
#   app:   frontend node-api java-api java-worker
#   infra: localdb (bundled Postgres)  kafka  mail (Mailpit)  kafka-ui
# Database on RDS: leave `localdb` out.
COMPOSE_PROFILES=frontend,node-api,java-api,java-worker,kafka,mail

# Address people type in the browser: the server's public IP or DNS name.
PUBLIC_HOST=CHANGE_ME
PUBLIC_SCHEME=http

# Database connection - the ONLY place to change it.
# RDS: the endpoint. Bundled Postgres (profile localdb): postgres
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Must be IDENTICAL for the service that signs tokens and the ones that verify
# them. 32+ random bytes:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME


# ============================ 2. CHECK PER APP ================================
# ---- Node API  (profile: node-api) ------------------------------------------
# folder with package.json
NODE_API_DIR=./services/node-api
NODE_API_PORT=3000
NODE_API_NODE_VERSION=20
# auto = first of dist/main.js, dist/src/main.js, dist/index.js ... that exists
NODE_API_START_CMD=auto
# URL answering 200 without login; empty = port check only
NODE_API_HEALTH_PATH=

# ---- Java API  (profile: java-api) ------------------------------------------
# folder with pom.xml or gradlew
JAVA_API_DIR=./services/java-api
JAVA_API_PORT=8081
# = <java.version> in pom.xml
JAVA_API_JAVA_VERSION=21
# Spring Boot actuator: /actuator/health. Empty = port check only
JAVA_API_HEALTH_PATH=/actuator/health
# Special layouts, explained at the top of java.Dockerfile (leave out if not needed):
# JAVA_API_DOCKERFILE=Dockerfile.java
# JAVA_API_APP_DIR=order-service
# JAVA_API_PRE_INSTALL_DIRS=shared-libs/domain-engine
# JAVA_API_MODULE=services/order-service
# JAVA_API_EXTRA_DIR=./databases/postgresql
# JAVA_API_EXTRA_DEST=/databases/postgresql
# JAVA_API_RUNTIME_APK=python3

# ---- Java worker  (profile: java-worker) ------------------------------------
JAVA_WORKER_DIR=./services/java-worker
JAVA_WORKER_PORT=8082
JAVA_WORKER_JAVA_VERSION=21
# empty = port check. A worker with no web server at all (no port): process
JAVA_WORKER_HEALTH_PATH=

# ---- Frontend  (profile: frontend) ------------------------------------------
# folder with package.json
FRONTEND_DIR=./frontend
# port opened in the browser - the ONLY port that has to be open to users
FRONTEND_PORT=4200
# Angular 19+: 22, Angular 17/18: 20, Angular 16: 18
FRONTEND_NODE_VERSION=22
FRONTEND_BUILD_SCRIPT=build

# How does the page call the backend?  (README step 5)
# Case 1 - ABSOLUTE addresses in the code (http://localhost:3000 ...). List each
# one as  from=to . `to` sends the call through the frontend's own nginx:
#   .../_node -> Node API      .../_java -> Java API
FRONTEND_URL_REWRITES=http://localhost:3000=${PUBLIC_SCHEME}://${PUBLIC_HOST}:${FRONTEND_PORT}/_node http://localhost:8081=${PUBLIC_SCHEME}://${PUBLIC_HOST}:${FRONTEND_PORT}/_java
# Case 2 - RELATIVE addresses (/api/..., /auth/...). List the first path segments,
# separated by | , and where they go. KEEP = Java API, KEEP2 = Node API.
# FRONTEND_PROXY_KEEP_PATHS=api|actuator
# FRONTEND_PROXY_KEEP2_PATHS=auth
# A prefix that must be REMOVED before forwarding (/auth-svc/login -> /login):
# FRONTEND_PROXY_NODE_PREFIX=auth-svc
# FRONTEND_PROXY_JAVA_PREFIX=trade-api
# A build script that needs env values or a file outside the frontend folder:
# FRONTEND_BUILD_ENV=API_URL=http://localhost:8081
# FRONTEND_EXTRA_DIR=./Config
# FRONTEND_EXTRA_DEST=/Config

# ---- Database ----------------------------------------------------------------
# Appended to the JDBC URL. Examples: ?currentSchema=trading   ?sslmode=require
# Single quotes keep ${...} for Spring to resolve.
JDBC_PARAMS=
# Only with profile localdb: folder of *.sql run once on an empty database.
DB_INIT_DIR=

# ---- Kafka  (profile: kafka) -------------------------------------------------
# Address the app containers use. Managed Kafka (MSK): its bootstrap string.
KAFKA_INTERNAL=kafka:29092
# Space-separated  name:partitions:retention_ms . Must match the names in the code.
KAFKA_TOPICS=orders:3:604800000 orders.DLT:3:2592000000
# true = a topic missing from the list is created on first use
KAFKA_AUTO_CREATE_TOPICS=false

# ---- Shared config folder ----------------------------------------------------
# A folder of the repo that services read at run time (e.g. ./Config with
# application.yml). Mounted read-only into every app container at APP_CONFIG_MOUNT.
# A service that looks for ../../Config/application.yml finds it at /Config.
# APP_CONFIG_DIR=./Config
# APP_CONFIG_MOUNT=/Config


# ============================ 3. APP-SPECIFIC =================================
# Already provided to every app container - do NOT repeat them here:
#   DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD
#   PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD
#   POSTGRES_HOST POSTGRES_PORT POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD
#   SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD   (Java)
#   KAFKA_BOOTSTRAP_SERVERS  KAFKA_BROKERS  SPRING_KAFKA_BOOTSTRAP_SERVERS
#   CORS_ORIGINS  CORS_ALLOWED_ORIGINS  FRONTEND_URL
#   PORT  SERVER_PORT
#
# Add below every OTHER name your code reads - usually: copy your own
# .env.example here, then fix the addresses. Find missing names with:
#   Node:  grep -rhoE "process\.env\.[A-Z_0-9]+|get(Optional)?\('[A-Z_0-9]+'" <dir>/src | sort -u
#   Java:  grep -rhoE '\$\{[A-Z_0-9]+' <dir>/src/main | sort -u
#
# Reuse the values above instead of typing them again, so the connection
# changes in one place:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# AUTH_DB_NAME=${DB_NAME}
# JWT_SIGNING_KEY=${JWT_SECRET}
# ORDER_SERVICE_URL=http://java-api:8081
# AUTH_SERVICE_URL=http://node-api:3000
# MAIL_HOST=mailpit
# MAIL_PORT=1025


# ============================ 4. RARELY CHANGED ===============================
POSTGRES_VERSION=16
KAFKA_VERSION=3.8.0
MAVEN_VERSION=3.9.9
# Host port, when it must differ from the port inside the container
# NODE_API_HOST_PORT=
# JAVA_API_HOST_PORT=
# Host ports for tools on the box itself (bound to 127.0.0.1).
DB_HOST_PORT=5432
KAFKA_HOST_PORT=9092
MAIL_UI_PORT=8025
KAFKA_UI_PORT=8888
